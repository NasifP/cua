# Copy to .env and fill in. Never commit the real file.

# --- What the bot may do -------------------------------------------------
# live_read_only     reads your real account, never clicks or types. Start here.
# simulator_only     only on a Thndr paper account; halts on a real one.
# live_prepare_only  fills an order ticket on your real account; you press
#                    submit. Needs calibration first (see README).
EGX_MODE=live_read_only

# --- Desktop app display (the sidebar buttons change these) ---
# ar (Arabic, right to left) or en. The dashboard page follows it inside the app.
EGX_LANG=ar
# dark or light.
EGX_THEME=dark

# --- Bus (shared by the agent and the dashboard) ---
EGX_BUS_PATH=state/egx_bus.db

# --- Dashboard ---
# Must be >= 24 chars. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
EGX_DASHBOARD_TOKEN=
EGX_DASHBOARD_HOST=127.0.0.1
EGX_DASHBOARD_PORT=8787
# Only set this if the app sits behind a tunnel that terminates TLS and authenticates.
# EGX_ACKNOWLEDGE_PUBLIC_BIND=yes

# --- Cua ---
CUA_API_KEY=
CUA_CONTAINER_NAME=

# --- Models (optional; the bot works without them, more conservatively) ---
# Any litellm-supported ID. Provider model names move, so check the current list.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Chat assistant on the dashboard. OFF by default: enabling it sends your
# holdings and their values to the model provider.
EGX_CHAT_ENABLED=false
EGX_CHAT_MODEL=gemini/gemini-2.5-flash

# News circuit breaker. Can only ever escalate a headline's severity, so a bad
# answer here cannot unblock trading.
EGX_CLASSIFIER_MODEL=gemini/gemini-2.5-flash

# Reads your holdings off a screenshot of the Positions tab (litellm ID). Falls
# back to EGX_CHAT_MODEL when unset. Sends that screenshot to the provider.
EGX_VISION_MODEL=gemini/gemini-2.5-flash

# Seconds between cycles while the market is open (at least 60).
EGX_CYCLE_SECONDS=300

# Model calls stop for the day at either limit (the spend limit is in EGP,
# converted at the day's USD/EGP rate). The call limit also works for
# models litellm has no price for. Settings in the desktop app edits these.
EGX_DAILY_SPEND_LIMIT_EGP=100
EGX_DAILY_CALL_LIMIT=400

# Strategy: true lets trend, momentum, volume and volatility decide what to hold
# and how much, instead of the fixed allocation. Compare both in the Strategy
# Lab first. Every other gate (news brake, lab rules, turnover cap, you pressing
# Buy) still applies.
EGX_FOUR_FACTOR=false

# Desktop app: lets the Thndr X tab write a buy order's quantity and limit price
# into an open Thndr ticket when you press Fill. It never presses Buy; you do.
# Off until you turn it on (Settings -> Behaviour).
EGX_TICKET_FILL=false

# Chat analysis as a team: technical, news and risk specialists answer at once
# on EGX_COMMITTEE_MODEL (empty: the chat model), then EGX_ANALYST_MODEL decides
# from their reports. A buy is prepared only when risk and news allow it. The
# worst-case cost of each answer is reserved from the daily limit first.
EGX_COMMITTEE=true
EGX_COMMITTEE_MODEL=

# Desktop app: the chat analyst may open stock pages, tabs and search in the
# Thndr X window, and get a buy ready for you (shown in the ticket panel, and
# filled into the ticket when EGX_TICKET_FILL is on). It can never press Buy,
# Sell or anything that moves money. HALT stops it.
EGX_BROWSE=true

# Seconds between pressing START on the dashboard and the bot's first
# screenshot, so you can bring Thndr X to the front. Halting cancels it.
EGX_ARM_DELAY=10

# Only if Tesseract is installed somewhere unusual. Normally found on PATH or
# in C:\Program Files\Tesseract-OCR without any setting.
# EGX_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Drives the screen, so it needs computer-use support -- not every model has it.
EGX_AGENT_MODEL=anthropic/claude-sonnet-5

# Only for a Gemini EGX_AGENT_MODEL, e.g. gemini-2.5-computer-use-preview-10-2025
# (no "gemini/" prefix). cua-agent drives Gemini through Google's own SDK rather
# than litellm, and that SDK reads GOOGLE_API_KEY, not GEMINI_API_KEY above.
# Same key from aistudio.google.com works for both. Unset, it falls back to
# Vertex AI credentials. Needs: pip install "cua-agent[gemini]"
GOOGLE_API_KEY=

# Investing style for each holding's stop and targets: trader, swing or long.
EGX_STYLE=swing

# Draw the built-in browser in software (fixes a frozen Thndr X on some PCs).
EGX_BROWSER_SOFTWARE=true
