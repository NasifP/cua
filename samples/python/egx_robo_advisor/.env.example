# Copy to .env and fill in. Never commit the real file.

# --- Bus (shared by the agent and the dashboard) ---
EGX_BUS_PATH=state/egx_bus.db

# --- Dashboard ---
# Must be >= 24 chars. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
EGX_DASHBOARD_TOKEN=
EGX_DASHBOARD_HOST=127.0.0.1
EGX_DASHBOARD_PORT=8787
# Only set this if the app sits behind a tunnel that terminates TLS and authenticates.
# EGX_ACKNOWLEDGE_PUBLIC_BIND=yes

# --- Cua ---
CUA_API_KEY=
CUA_CONTAINER_NAME=

# --- Models (optional; the bot works without them, more conservatively) ---
# Any litellm-supported ID. Provider model names move, so check the current list.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Chat assistant on the dashboard. OFF by default: enabling it sends your
# holdings and their values to the model provider.
EGX_CHAT_ENABLED=false
EGX_CHAT_MODEL=gemini/gemini-2.5-pro

# News circuit breaker. Can only ever escalate a headline's severity, so a bad
# answer here cannot unblock trading.
EGX_CLASSIFIER_MODEL=gemini/gemini-2.5-pro

# Drives the screen, so it needs computer-use support -- not every model has it.
EGX_AGENT_MODEL=anthropic/claude-sonnet-5

# Only for a Gemini EGX_AGENT_MODEL, e.g. gemini-2.5-computer-use-preview-10-2025
# (no "gemini/" prefix). cua-agent drives Gemini through Google's own SDK rather
# than litellm, and that SDK reads GOOGLE_API_KEY, not GEMINI_API_KEY above.
# Same key from aistudio.google.com works for both. Unset, it falls back to
# Vertex AI credentials. Needs: pip install "cua-agent[gemini]"
GOOGLE_API_KEY=
